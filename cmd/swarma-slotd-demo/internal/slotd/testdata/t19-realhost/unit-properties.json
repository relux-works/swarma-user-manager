{
  "LoadState": "loaded",
  "ActiveState": "active",
  "SubState": "running",
  "ControlPID": "0",
  "Type": "exec",
  "User": "{{USER}}",
  "Group": "{{USER}}",
  "WorkingDirectory": "{{HOME}}",
  "MemoryMax": "{{MEMORY}}",
  "TasksMax": "{{TASKS}}",
  "NoNewPrivileges": "yes",
  "ProtectSystem": "strict",
  "ProtectHome": "tmpfs",
  "PrivateTmp": "yes",
  "PrivateDevices": "yes",
  "ProtectKernelTunables": "yes",
  "ProtectKernelModules": "yes",
  "ProtectControlGroups": "yes",
  "RestrictSUIDSGID": "yes",
  "LockPersonality": "yes",
  "CapabilityBoundingSet": "",
  "Slice": "system.slice",
  "BindPaths": "{{HOME}}:{{HOME}}:rbind",
  "BindReadOnlyPaths": "{{BIND_RO}}",
  "TemporaryFileSystem": "/run:ro /var:ro /dev/shm:ro",
  "RestrictAddressFamilies": "AF_INET AF_INET6 AF_UNIX",
  "SystemCallArchitectures": "native",
  "PrivateIPC": "yes",
  "RestrictNamespaces": "yes",
  "ProtectProc": "invisible",
  "ProcSubset": "pid",
  "IPAddressDeny": "0.0.0.0/0 ::/0",
  "IPAddressAllow": "{{IP_ALLOW}}",
  "SupplementaryGroups": "{{GROUPS}}",
  "Environment": "",
  "EnvironmentFiles": "",
  "PassEnvironment": "",
  "StandardInput": "null",
  "StandardOutput": "journal",
  "StandardError": "journal",
  "CPUQuotaPerSecUSec": "t {{CPU_US}}",
  "RuntimeMaxUSec": "t {{RUNTIME_US}}",
  "Description": "slotd-demo:{{UNIT_TOKEN}}",
  "ControlGroup": "/system.slice/{{UNIT}}"
}
